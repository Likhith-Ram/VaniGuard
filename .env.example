# VaniGuard Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── API Authentication ─────────────────────────────────────────────────────
# Secret key required by all protected endpoints.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
VANIGUARD_API_KEY=your-secret-api-key-here

# ── CORS: allowed frontend origin ──────────────────────────────────────────
# Set to your deployed Next.js origin in production.
# Must NOT be a wildcard (*) when credentials are enabled.
VANIGUARD_FRONTEND_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
VANIGUARD_DB_USER=vaniguard
VANIGUARD_DB_PASSWORD=change-me-in-production
VANIGUARD_DB_NAME=vaniguard_db
VANIGUARD_DB_HOST=localhost
VANIGUARD_DB_PORT=5433

# ── Upload limits ──────────────────────────────────────────────────────────
# Maximum audio upload size in bytes (default: 50 MB)
VANIGUARD_MAX_UPLOAD_BYTES=52428800

# Maximum WebSocket message size in bytes (default: 1 MB)
VANIGUARD_MAX_WS_MSG_BYTES=1048576

# ── Inference concurrency ──────────────────────────────────────────────────
# Maximum number of simultaneous ONNX inference jobs.
# Set to number of available CPU cores for best throughput.
VANIGUARD_MAX_CONCURRENT_INFERENCE=4
